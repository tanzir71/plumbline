---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
import { REPO, url } from "../lib/url";

const links = [
  ["Cost", url("#cost")],
  ["Product", url("#product")],
  ["Lenses", url("#lenses")],
  ["Docs", url("docs/")],
  ["Changelog", url("changelog/")],
];
---

<header class="nav">
  <Logo />
  <nav id="site-menu" aria-label="Main">
    <ul>
      {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <div class="menu-actions">
      <Button href={REPO}>GitHub</Button>
      <Button variant="primary" href={url("#install")}>Install</Button>
    </div>
  </nav>
  <div class="actions">
    <Button href={REPO}>GitHub</Button>
    <Button variant="primary" href={url("#install")}>Install</Button>
  </div>
  <button class="toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
  </button>
</header>

<style>
  .nav {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 72px;
    padding: 14px var(--gutter);
    background: var(--bg-canvas);
  }
  ul {
    display: flex;
    gap: 32px;
  }
  li a {
    font-size: 14px;
    line-height: 18px;
    color: var(--text-secondary);
    transition: color 120ms ease;
  }
  li a:hover {
    color: var(--text-primary);
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .menu-actions,
  .toggle {
    display: none;
  }

  @media (max-width: 1023px) {
    .nav {
      grid-template-columns: auto 1fr auto;
      gap: 16px;
    }
    nav ul {
      justify-content: center;
      gap: 20px;
    }
  }

  @media (max-width: 767px) {
    .nav {
      grid-template-columns: 1fr auto;
      height: 64px;
    }
    .actions {
      display: none;
    }
    .toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: var(--r-md);
      background: var(--bg-raised);
      color: var(--text-primary);
    }
    nav {
      display: none;
      position: absolute;
      z-index: 10;
      top: 100%;
      left: 0;
      right: 0;
      padding: 8px var(--gutter) 24px;
      background: var(--bg-canvas);
    }
    nav[data-open] {
      display: block;
    }
    nav ul {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0;
    }
    li a {
      display: block;
      padding: 12px 0;
      font-size: 16px;
    }
    .menu-actions {
      display: flex;
      gap: 10px;
      margin-top: 12px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".toggle");
  const menu = document.getElementById("site-menu");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (open) menu.dataset.open = "";
    else delete menu.dataset.open;
  }

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  menu?.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
