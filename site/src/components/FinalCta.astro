---
import arrow from "../assets/figma/arrow-14.svg?url";
import Button from "./Button.astro";
import GlowMesh from "./GlowMesh.astro";
import { url } from "../lib/url";

/** Each step names the real part of Plumbline it produces. */
const steps = [
  { text: "Contract drafted from your ADRs and agent rules", output: "plumbline.yml" },
  { text: "Lenses tuned on your own labelled PRs", output: "plumbline benchmark" },
  { text: "CI gating set up branch by branch", output: "gate + lanes" },
];
---

<section id="audit" class="cta" aria-labelledby="cta-title">
  <div class="inner cols">
    <div class="left">
      <h2 id="cta-title">Keep your architecture true.</h2>
      <p class="lead">Open source, MIT licensed, and free to run with the model keys you already have.</p>
      <div class="buttons">
        <Button variant="primary" href={url("#install")}>Install Plumbline</Button>
        <Button href={url("docs/")}>Read the docs</Button>
      </div>
    </div>

    <div class="box-wrap">
      <GlowMesh variant="cta" />
      <div class="box" role="group" aria-labelledby="audit-title">
        <div class="box-head">
          <p class="micro">FOR TEAMS ROLLING OUT</p>
          <span class="count">{steps.length} steps</span>
        </div>
        <div class="box-body">
          <h3 id="audit-title">Architecture audit</h3>
          <ol>
            {steps.map(({ text, output }, i) => (
              <li>
                <span class="n" aria-hidden="true">{`0${i + 1}`}</span>
                <div><p>{text}</p><code>{output}</code></div>
              </li>
            ))}
          </ol>
        </div>
        <div class="box-foot">
          <span class="note">You approve every merge</span>
          <a class="book" href="#audit">Book an architecture audit <img src={arrow} alt="" width="14" height="14" /></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 96px var(--gutter);
    background: var(--bg-canvas);
    overflow: clip;
  }
  .cols {
    display: flex;
    align-items: center;
    gap: 56px;
  }
  .left {
    /* Keeps the text above the light behind the teams box. */
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1 1 0;
    min-width: 0;
  }
  h2 {
    max-width: 620px;
    font-size: 40px;
    font-weight: 600;
    line-height: 46px;
    letter-spacing: -1px;
  }
  .lead {
    max-width: 520px;
    font-size: 16px;
    line-height: 25px;
    color: var(--text-secondary);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 6px;
  }
  .box-wrap {
    position: relative;
    isolation: isolate;
    flex: none;
    width: 460px;
  }
  /* A dialog built from tonal bands, like the hero panel. No strokes. */
  .box {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-2xl);
    background: var(--bg-surface);
    overflow: clip;
  }
  .box-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 24px;
    background: var(--bg-raised);
  }
  .count,
  .note {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 14px;
  }
  .box-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
  }
  h3 {
    font-size: 22px;
    font-weight: 500;
    line-height: 28px;
    letter-spacing: -0.33px;
    color: var(--text-primary);
  }
  ol {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .n {
    flex: none;
    color: var(--accent-plumb);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 20px;
  }
  li div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  li p {
    font-size: 14px;
    line-height: 20px;
    color: var(--text-primary);
  }
  li code {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 16px;
  }
  .box-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    padding: 12px 12px 12px 24px;
    background: var(--bg-inset);
  }
  .book {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    padding: 9px 13px;
    border-radius: var(--r-md);
    background: var(--bg-raised);
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
    white-space: nowrap;
    transition: background-color 120ms ease;
  }
  .book:hover {
    background: #282a2e;
  }

  @media (max-width: 1279px) {
    .box-wrap {
      width: 400px;
    }
  }
  @media (max-width: 1023px) {
    .cols {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }
    .left {
      flex: none;
    }
    .box-wrap {
      width: 100%;
      max-width: 460px;
    }
    h2 {
      font-size: 32px;
      line-height: 38px;
      letter-spacing: -0.8px;
    }
  }
  @media (max-width: 767px) {
    .cta {
      padding: var(--section-y) var(--gutter);
    }
    h2 {
      font-size: 28px;
      line-height: 34px;
    }
    .box-head {
      padding: 12px 18px;
    }
    .box-body {
      padding: 20px 18px;
    }
    .box-foot {
      padding: 12px;
    }
    .note {
      padding-left: 6px;
    }
    .book {
      justify-content: center;
      width: 100%;
      margin-left: 0;
    }
  }
</style>
