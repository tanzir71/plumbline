---
import Button from "./Button.astro";
import CopyButton from "./CopyButton.astro";
import FindingRow from "./FindingRow.astro";
import GlowMesh from "./GlowMesh.astro";
import Signal from "./Signal.astro";
import snippets from "../data/snippets.json";
import { REPO, url } from "../lib/url";

const glance = [
  ["Runs in", "Claude Code, Codex, OpenCode, CI, MCP"],
  ["Models", "Your key, any provider your agent supports"],
  ["Data", "Leaves only for your model endpoint"],
  ["Severity", "P0–P3, proof required on P0 and P1"],
  ["Output", "PR comment, terminal, JSON, SARIF"],
  ["License", "MIT. No account, no Plumbline servers"],
];

/** Nodes sit on a symmetric grid. The last value marks the two modules in the cycle. */
const nodes: [string, number, number, boolean][] = [
  ["api/invoices", 154, 8, false],
  ["billing", 36, 124, true],
  ["users/session", 272, 124, true],
  ["orgs", 36, 240, false],
  ["db/invoices", 272, 240, false],
];
const NODE_W = 132;
const NODE_H = 34;

const edges = {
  apiBilling: "M196 44V73a10 10 0 0 1-10 10H112a10 10 0 0 0-10 10V122",
  apiUsers: "M244 44V73a10 10 0 0 0 10 10H328a10 10 0 0 1 10 10V122",
  usersBilling: "M270 133H170",
  billingUsers: "M170 149H270",
  billingOrgs: "M102 160V238",
  billingDb: "M134 160V189a10 10 0 0 0 10 10H328a10 10 0 0 1 10 10V238",
};
const arrows = [
  "M97.5 117.5L102 122L106.5 117.5",
  "M333.5 117.5L338 122L342.5 117.5",
  "M174.5 128.5L170 133L174.5 137.5",
  "M97.5 233.5L102 238L106.5 233.5",
  "M333.5 233.5L338 238L342.5 233.5",
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="inner">
    <div class="top">
      <div class="text">
        <p class="pill"><span class="dot"></span>Open source · MIT · bring your own keys</p>
        <h1 id="hero-title"><span>Review the structure,</span><span class="second">not just the diff.</span></h1>
        <p class="lead">
          Plumbline is an open-source code reviewer that runs inside Claude Code, Codex and OpenCode. It hunts regressions like the hosted bots, then checks every PR against the architecture your team agreed on, and proves every serious finding.
        </p>
        <div class="cta">
          <div class="install">
            <span class="prompt" aria-hidden="true">$</span>
            <code>{snippets.cliInstall}</code>
            <CopyButton text={snippets.cliInstall} label="Copy install command" />
          </div>
          <Button href={REPO}>Star on GitHub</Button>
          <Button href={url("docs/")}>Docs</Button>
        </div>
      </div>

      <div class="glance">
        <div class="glance-head"><h2>AT A GLANCE</h2><span>v1.1</span></div>
        <dl>
          {glance.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
    </div>

    <div class="shot-wrap">
      <GlowMesh variant="hero" />
      <figure class="shot" aria-label="Example Plumbline review of a pull request">
        <figcaption class="bar">
          <span class="bar-left"><span class="cmd">plumbline review</span><span class="pr">PR #482 &nbsp;·&nbsp; feat: org-level invoices</span></span>
          <span class="stats">6 lenses &nbsp;·&nbsp; 3 findings</span>
        </figcaption>
        <div class="body">
          <div class="findings">
            <div class="score">
              <p class="value">3/5</p>
              <div>
                <p class="verdict">Merge after fixes</p>
                <p class="counts">2 × P1 &nbsp;·&nbsp; 1 × P2 &nbsp;·&nbsp; 14 checks passed</p>
              </div>
            </div>
            <FindingRow
              severity="P1"
              lens="architecture"
              title="New import creates a cycle: billing -> users/session -> billing"
              body="billing/invoice.ts now imports users/session to read the org. users/session already depends on billing for plan limits."
              proof="proof: dependency graph diff + rule ADR-012"
            />
            <FindingRow
              severity="P1"
              lens="pattern"
              title="listAll() skips the org_id scope used by 23 of 23 sibling methods"
              body="InvoiceRepo.listAll() reads across tenants. Every other repository method filters by org_id first."
              proof="proof: failing test invoice.tenant.spec.ts"
            />
            <FindingRow
              severity="P2"
              lens="migration"
              title="Dropping invoices.legacy_total breaks the rolling deploy"
              body="Old pods keep reading the column until the rollout finishes. Ship it as expand, migrate, contract."
              proof="proof: deploy-order check"
            />
          </div>

          <div class="diff">
            <p class="micro">DEPENDENCY DIFF</p>
            <svg class="graph" width="440" height="290" viewBox="0 0 440 290" fill="none" role="img" aria-label="Dependency graph. A new edge from billing to users/session closes a cycle, because users/session already depends on billing.">
              <g stroke="#3A3D43" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                {[edges.apiBilling, edges.apiUsers, edges.usersBilling, edges.billingOrgs, edges.billingDb].map((d) => <path d={d}></path>)}
                {arrows.map((d) => <path d={d}></path>)}
              </g>
              <path class="edge-solid" d={edges.billingUsers} stroke="#FF6B81" stroke-width="2" stroke-linecap="round"></path>
              <path class="edge-solid" d="M264.5 143.5L270 149L264.5 154.5" stroke="#FF6B81" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              <Signal d={edges.apiBilling} at={0} />
              <Signal d={edges.apiUsers} at={0.3} />
              <Signal d={edges.billingOrgs} at={1.2} />
              <Signal d={edges.billingDb} at={1.5} />
              <Signal d={edges.billingUsers} at={2.9} tone="red" />
              <Signal d={edges.usersBilling} at={4.4} tone="red" />
              {nodes.map(([, x, y]) => <rect x={x} y={y} width={NODE_W} height={NODE_H} rx="8" fill="#26282C"></rect>)}
              {nodes.map(([t, x, y, cycle]) => (
                <text class:list={{ quiet: !cycle }} x={x + NODE_W / 2} y={y + NODE_H / 2} text-anchor="middle" dominant-baseline="central">{t}</text>
              ))}
              <text class="signal-hit" x="338" y="141" text-anchor="middle" dominant-baseline="central" style="--at: 2.9s">users/session</text>
            </svg>
            <div class="legend">
              <span><i style="background: var(--line-edge)"></i>existing edge</span>
              <span><i style="background: var(--sev-p0)"></i>added in this PR</span>
            </div>
            <div class="broken">
              <p class="rule-name">forbid: billing -&gt; users/*</p>
              <p>ADR-012 · billing must stay deployable on its own</p>
            </div>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 64px var(--gutter) var(--section-y);
    background: var(--bg-canvas);
    overflow: clip;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .top {
    /* Keeps the text above the light behind the product shot. */
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    flex: 0 1 640px;
    min-width: 0;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    border-radius: var(--r-pill);
    background: var(--bg-raised);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-plumb);
  }
  h1 {
    font-size: 52px;
    font-weight: 600;
    line-height: 56px;
    letter-spacing: -1.56px;
  }
  h1 span {
    display: block;
  }
  h1 .second {
    color: var(--text-secondary);
  }
  .lead {
    max-width: 580px;
    font-size: 17px;
    line-height: 27px;
    color: var(--text-secondary);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 6px;
  }
  .install {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    max-width: 100%;
    padding: 5px 5px 5px 16px;
    border-radius: var(--r-md);
    background: var(--bg-raised);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 17px;
  }
  .install code {
    min-width: 0;
    font-size: 13px;
    color: var(--text-primary);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .prompt {
    color: var(--text-muted);
  }

  .glance {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1 1 0;
    min-width: 0;
  }
  .glance-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 14px;
  }
  .glance-head h2 {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.88px;
  }
  dl {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  dl div {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  dt {
    flex: none;
    width: 92px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.66px;
    text-transform: uppercase;
  }
  dd {
    font-size: 13px;
    line-height: 18px;
    color: var(--text-primary);
  }

  .shot-wrap {
    position: relative;
    isolation: isolate;
  }
  .shot {
    border-radius: var(--r-2xl);
    background: var(--bg-surface);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 24px;
    background: var(--bg-raised);
    line-height: 17px;
  }
  .bar-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    font-size: 13px;
  }
  .cmd {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text-primary);
  }
  .pr {
    color: var(--text-secondary);
  }
  .stats {
    flex: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .body {
    display: flex;
    align-items: stretch;
  }
  .findings {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0 1 680px;
    min-width: 0;
    padding: 24px;
  }
  .score {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 6px;
  }
  .value {
    font-size: 48px;
    line-height: 62px;
    font-weight: 600;
    letter-spacing: -1.44px;
    color: var(--text-primary);
  }
  .score > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .verdict {
    font-size: 17px;
    line-height: 22px;
    font-weight: 500;
    color: var(--text-primary);
  }
  .counts {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .diff {
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1 1 0;
    min-width: 0;
    padding: 24px;
    background: var(--bg-inset);
  }
  .graph {
    max-width: 100%;
    height: auto;
  }
  .graph text {
    fill: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .graph text.quiet {
    fill: var(--text-secondary);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .legend i {
    width: 16px;
    height: 2px;
  }
  .broken {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--sev-p0) var(--tint-alert), transparent);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .rule-name {
    color: var(--sev-p0);
    font-weight: 500;
  }

  @media (max-width: 1279px) {
    .top {
      gap: 40px;
    }
    .glance {
      flex-basis: 320px;
    }
    dl div {
      align-items: flex-start;
    }
    .findings {
      flex: 1 1 58%;
    }
    .diff {
      flex: 1 1 42%;
    }
  }
  @media (max-width: 1023px) {
    .top {
      flex-direction: column;
      align-items: stretch;
    }
    .text {
      flex-basis: auto;
    }
    .glance {
      flex-basis: auto;
    }
    h1 {
      font-size: 44px;
      line-height: 48px;
    }
    .body {
      flex-direction: column;
    }
    .findings,
    .diff {
      flex: none;
    }
    .graph {
      align-self: center;
    }
  }
  @media (max-width: 767px) {
    h1 {
      font-size: 36px;
      line-height: 40px;
      letter-spacing: -1.08px;
    }
    .hero {
      padding-top: 32px;
    }
    .install {
      width: 100%;
    }
    .install code {
      flex: 1;
    }
    .bar {
      flex-direction: column;
      align-items: flex-start;
      padding: 14px 16px;
    }
    .findings,
    .diff {
      padding: 16px;
    }
    dt {
      width: 76px;
    }
  }
</style>
