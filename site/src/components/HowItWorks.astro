---
import PassColumn from "./PassColumn.astro";
import SectionHead from "./SectionHead.astro";
---

<section class="section bg-surface" aria-labelledby="how-title">
  <div class="inner stack">
    <SectionHead id="how-title" num="03" label="How it works" lines={["Four passes.", "One report you can trust."]} lead="The same flow runs in your agent, your terminal, CI and over MCP.">
      <p class="command"><span>one command</span><code>/plumbline review</code></p>
    </SectionHead>

    <ol class="pipeline">
      <PassColumn num="01" kind="scope" title="Pin the change" desc="Pins the diff range and loads AGENTS.md, CLAUDE.md, ADRs and plumbline.yml.">{`base    main @ 8f2c1a0
head    feat/org-invoices
diff    14 files  +412 -96
rules   AGENTS.md  ADR-012
        plumbline.yml`}</PassColumn>
      <PassColumn num="02" kind="review" title="Review in parallel" desc="Bug hunters trace real values while architecture lenses read the graph.">{`A  regressions     2
B  regressions     1
C  architecture    3
D  hygiene, ops    1
   candidates      `}<b>7</b></PassColumn>
      <PassColumn num="03" kind="prove" title="Prove it or drop it" desc="Every P0 and P1 needs a failing test, a graph diff or a broken rule.">{`cycle     graph_diff  `}<span class="kept">kept</span>{`
tenancy   test `}<span class="fail">FAIL</span>{`   `}<span class="kept">kept</span>{`
null qty  no repro    -> P2
naming    style       `}<span class="dropped">dropped</span></PassColumn>
      <PassColumn last num="04" kind="report" title="Score and post" desc="Merge score, ranked findings and a dependency diff, locally or on the PR.">{`merge score  `}<b>3/5</b>{`
findings     P1 x2  P2 x1
`}<span class="dropped">dropped</span>{`      4
posted       PR #482`}</PassColumn>
    </ol>
  </div>
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .command {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    border-radius: var(--r-sm);
    background: var(--bg-inset);
    line-height: 17px;
  }
  .command span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .command code {
    color: var(--accent-plumb);
    font-size: 13px;
    font-weight: 500;
  }
  .pipeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .pipeline :global(b) {
    font-weight: 400;
    color: var(--text-primary);
  }
  .pipeline :global(.kept) {
    color: var(--accent-plumb);
  }
  .pipeline :global(.fail) {
    color: var(--sev-p0);
  }
  .pipeline :global(.dropped) {
    color: var(--text-muted);
  }
  @media (max-width: 1279px) {
    .pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
  @media (max-width: 767px) {
    .pipeline {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
  }
</style>
