---
import arrow from "../assets/figma/arrow.svg?url";
import { url } from "../lib/url";
---

<aside class="bar" aria-label="Release announcement">
  <span class="version">v1.2</span>
  <p>Plumbline 1.2: choose your review models, set a budget and test the mix on your own PRs. Open source under MIT.</p>
  <a href={url("changelog/")}>Read the release notes <img src={arrow} alt="" width="12" height="12" /></a>
</aside>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 9px var(--gutter);
    min-height: 36px;
    background: var(--bg-surface);
    font-size: 13px;
    line-height: 17px;
  }
  .version {
    flex: none;
    padding: 2px 6px;
    border-radius: var(--r-xs);
    background: color-mix(in srgb, var(--accent-plumb) var(--tint-accent), transparent);
    color: var(--accent-plumb);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
  }
  p {
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    font-weight: 500;
    color: var(--text-primary);
  }
  @media (max-width: 1023px) {
    p {
      display: none;
    }
  }
</style>
