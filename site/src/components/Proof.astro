---
const lines: [string, boolean][] = [
  ["// generated by plumbline · invoice.tenant.spec.ts", true],
  [`it("listAll() only returns the caller's org", async () => {`, false],
  ["  const a = await seedOrg();", false],
  ["  const b = await seedOrg();", false],
  ["  await seedInvoice({ org: b });", false],
  ["", false],
  ["  const rows = await InvoiceRepo.listAll(ctx(a));", false],
  ["  expect(rows).toHaveLength(0);", false],
  ["});", false],
];
---

<section class="section bg-canvas" aria-labelledby="proof-title">
  <div class="inner cols">
    <figure class="card">
      <pre><code class="lines">{lines.map(([text, comment], n) => <span class:list={{ c: comment }} style={`--n:${n}`}>{text || " "}</span>)}</code></pre>
      <figcaption class="result"><span class="fail">FAIL</span>expected 0 rows, received 1 &nbsp;·&nbsp; finding kept at P1</figcaption>
    </figure>

    <div class="copy">
      <p class="eyebrow"><span>06</span>&nbsp;&nbsp;PROOF, NOT OPINIONS</p>
      <h2 id="proof-title">No proof, no P1.</h2>
      <p class="lead">Noise is why teams mute review bots. Plumbline raises a P0 or P1 only when it can show it: a failing test it wrote and ran in your own environment, a dependency graph diff, or the exact rule that broke. Anything else is shown at P2 or lower, and a candidate is dropped only when the code rules it out.</p>
    </div>
  </div>
</section>

<style>
  .cols {
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: none;
    width: 616px;
    padding: 24px;
    border-radius: var(--r-xl);
    background: var(--bg-surface);
  }
  pre {
    overflow-x: auto;
    color: var(--text-primary);
    font-size: 13px;
    line-height: 21px;
  }
  pre code {
    display: block;
  }
  pre span {
    display: block;
    min-height: 21px;
    white-space: pre;
  }
  pre .c {
    color: var(--text-muted);
  }
  .result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--sev-p0) var(--tint-alert), transparent);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .fail {
    flex: none;
    color: var(--sev-p0);
    font-weight: 500;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1 1 0;
    min-width: 0;
  }
  .eyebrow {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.96px;
  }
  .eyebrow span {
    color: var(--accent-plumb);
  }
  h2 {
    font-size: 32px;
    font-weight: 600;
    line-height: 38px;
    letter-spacing: -0.64px;
  }
  .lead {
    font-size: 15px;
    line-height: 24px;
    color: var(--text-secondary);
  }

  @media (max-width: 1279px) {
    .cols {
      gap: 40px;
    }
    .card {
      flex: 1 1 0;
      width: auto;
      min-width: 0;
    }
  }
  @media (max-width: 1023px) {
    .cols {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .card,
    .copy {
      flex: none;
    }
    h2 {
      font-size: 28px;
      line-height: 34px;
    }
  }
  @media (max-width: 767px) {
    h2 {
      font-size: 26px;
      line-height: 32px;
    }
    .card {
      padding: 16px;
    }
    .result {
      align-items: flex-start;
    }
  }
</style>
