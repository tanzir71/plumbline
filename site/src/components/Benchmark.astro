---
import arrow from "../assets/figma/arrow-14.svg?url";
import CopyButton from "./CopyButton.astro";
import SectionHead from "./SectionHead.astro";
import fieldTest from "../data/field-test.json";
import { url } from "../lib/url";

const results = [
  { label: "Candidates proposed", note: "before triage", value: fieldTest.candidates, detail: `Four reviewer passes proposed them. Triage rejected ${fieldTest.candidatesRejected} and merged duplicates.`, accent: false },
  { label: "Findings reported", note: `${fieldTest.p1} P1 · ${fieldTest.p2} P2`, value: fieldTest.findings, detail: `${fieldTest.findings - fieldTest.importCycles} came from reviewers and ${fieldTest.importCycles} from the import graph.`, accent: false },
  { label: "Judged real", note: `of ${fieldTest.rootCauses} root causes`, value: fieldTest.judgedReal, detail: "Related findings were grouped, then checked against the reviewed commit.", accent: true },
  { label: "Impact unclear", note: `of ${fieldTest.rootCauses} root causes`, value: fieldTest.judgedUnclear, detail: `These cover all ${fieldTest.importCycles} new import cycles. The cycles exist, but their merge impact wasn't established.`, accent: false },
  { label: "P1s with a failing test", note: "proof", value: fieldTest.p1WithFailingTest, detail: `${fieldTest.proofTestFiles} test files ran on the reviewed commit and failed at an assertion.`, accent: false },
];

const issues = [
  { name: "Cycle scoring", happened: "One PR scored 0/5, mostly from automatic P1 cycles. Four of those paths shared one dependency cluster.", status: "Open", open: true },
  { name: "Graph scope", happened: "An earlier run changed scope and reported existing cycles as new.", status: "Fixed in 1.1.0", open: false },
  { name: "Proof status", happened: "A test runner crash was recorded as a failing test. That run stayed unscored.", status: "Fixed in 1.1.1", open: false },
];

const method = [
  ["Select", "Merged PRs from one team that already had a completed automated review."],
  ["Pin", "Each review is fixed to one commit and its merge base."],
  ["Check", "The import graph and contract rules run before any model."],
  ["Review", "Four reviewer passes read the change across the lenses."],
  ["Prove", "The CLI keeps a P1 only with a recorded failing test or graph diff."],
  ["Judge", "Findings are grouped by root cause and checked against the code."],
];

const strip = [
  ["Repos", String(fieldTest.repos), "private, one team"],
  ["Languages", "TS · Python", "graph checks cover TS"],
  ["Reviewer passes", String(fieldTest.reviewerPasses), "four per PR"],
  ["Agent", "Codex", "GPT-6"],
  ["Raw data", "Private", "aggregate counts only"],
];

const rows = [
  {
    goal: "Compare one PR",
    run: "/plumbline compare",
    result: "Both reviews side by side, with every disagreement checked against the code.",
  },
  {
    goal: "Benchmark many PRs",
    run: "plumbline benchmark run --yes",
    result: "Caught, missed and unlabelled comments for each reviewer, on issues you labelled.",
  },
  {
    goal: "Tune for your code",
    run: "plumbline benchmark compare",
    result: "What each lens or contract edit newly caught or missed.",
  },
];
---

<section id="benchmark" class="section bg-surface" aria-labelledby="benchmark-title">
  <div class="inner stack">
    <SectionHead
      id="benchmark-title"
      num="09"
      label="Benchmark"
      lines={["Tested on real PRs.", "Run it on yours."]}
      lead={`We ran Plumbline on ${fieldTest.prs} merged PRs from one team's private repos, then checked what it reported against the code. Run the same checks on your own PRs.`}
    >
      <a class="guide" href={url("docs/benchmark/")}>Read the benchmark guide <img src={arrow} alt="" width="14" height="14" /></a>
    </SectionHead>

    <div class="body">
      <div class="field">
        <p class="run-bar"><span class="tag">FIELD TEST</span><span>{fieldTest.prs} merged PRs · {fieldTest.repos} private repos</span></p>
        <table class="ledger">
          <caption class="sr-only">Plumbline field test counts</caption>
          <thead>
            <tr><th scope="col">Measure</th><th scope="col">Count</th><th scope="col">What it means</th></tr>
          </thead>
          <tbody>
            {results.map((row) => (
              <tr>
                <th scope="row"><span class:list={["name", { on: row.accent }]}>{row.label}</span><span class="sub">{row.note}</span></th>
                <td class="value">{row.value}</td>
                <td class="how">{row.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="limit">The workflow that produced these findings also judged them, so they don't show how many bugs were missed or how often raw model output is wrong. The PRs overlap, six reviews used a commit before the final merge, one large review left {fieldTest.largestUnreadPaths.toLocaleString("en-US")} paths partly read or unread, and full test suites were not run. This is not an accuracy measurement.</p>
      </div>

      <aside class="method" aria-labelledby="method-title">
        <h3 id="method-title">METHOD</h3>
        <ol>
          {method.map(([title, body], i) => (
            <li>
              <span class="rail" aria-hidden="true"><i></i><b></b></span>
              <div><p class="step"><span>{`0${i + 1}`}</span>{title}</p><p class="copy">{body}</p></div>
            </li>
          ))}
        </ol>
      </aside>
    </div>

    <dl class="strip">
      {strip.map(([key, value, note]) => (
        <div><dt>{key}</dt><dd>{value}</dd><dd class="note-cell">{note}</dd></div>
      ))}
    </dl>

    <div class="own">
      <h3>WHAT THE TEST EXPOSED</h3>
      <table class="issues">
        <caption class="sr-only">Problems the field test found in Plumbline</caption>
        <thead>
          <tr><th scope="col">Area</th><th scope="col">What happened</th><th scope="col">Status</th></tr>
        </thead>
        <tbody>
          {issues.map((row) => (
            <tr>
              <th scope="row">{row.name}</th>
              <td class="how">{row.happened}</td>
              <td class:list={["state", { open: row.open }]}>{row.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="own">
      <h3>RUN IT ON YOUR PRS</h3>
      <table class="commands">
        <caption class="sr-only">Ways to compare and tune reviewers</caption>
        <thead>
          <tr><th scope="col">Goal</th><th scope="col">Run</th><th scope="col">What you get</th></tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.goal}</th>
              <td><div class="run"><code>{row.run}</code><CopyButton text={row.run} label={`Copy ${row.run}`} tone="plain" /></div></td>
              <td class="how">{row.result}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">In Codex, use <code>$plumbline compare</code>. Bring in other reviewers from GitHub comments, SARIF or JSON.</p>
    </div>
  </div>
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .guide {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
  }
  .body {
    display: flex;
    align-items: flex-start;
    gap: 56px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1 1 0;
    min-width: 0;
  }
  .run-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .tag {
    flex: none;
    padding: 3px 8px;
    border-radius: var(--r-xs);
    background: var(--bg-raised);
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    letter-spacing: 0.66px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  thead th {
    padding: 0 0 10px;
    text-align: left;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
  }
  .ledger thead th:nth-child(1) { width: 236px; }
  .ledger thead th:nth-child(2) { width: 88px; }
  .commands thead th:nth-child(1) { width: 216px; }
  .commands thead th:nth-child(2) { width: 392px; }
  .issues thead th:nth-child(1) { width: 216px; }
  .issues thead th:nth-child(3) { width: 136px; }
  tbody tr {
    border-top: 1px solid var(--rule);
  }
  tbody tr:last-child {
    border-bottom: 1px solid var(--rule);
  }
  tbody th,
  tbody td {
    padding: 12px 16px 12px 0;
    text-align: left;
    vertical-align: middle;
  }
  tbody th {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
  }
  .commands tbody th,
  .commands tbody td,
  .issues tbody th,
  .issues tbody td {
    padding-top: 9px;
    padding-bottom: 9px;
  }
  .issues tbody td.how {
    padding-right: 16px;
  }
  .issues tbody td.state {
    padding-right: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
  }
  .issues tbody td.state.open {
    color: var(--text-primary);
  }
  .name,
  .sub {
    display: block;
  }
  .name.on {
    color: var(--accent-plumb);
  }
  .sub {
    margin-top: 2px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    line-height: 14px;
  }
  .value {
    color: var(--text-primary);
    font-size: 18px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: -0.18px;
    font-variant-numeric: tabular-nums;
  }
  tbody td.how {
    padding-right: 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 20px;
  }
  .limit {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 18px;
  }
  .method {
    flex: none;
    width: 340px;
  }
  h3 {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    letter-spacing: 0.88px;
  }
  .method ol {
    margin-top: 16px;
  }
  .method li {
    display: flex;
    gap: 14px;
  }
  .method li > div {
    flex: 1 1 0;
    min-width: 0;
    padding-bottom: 20px;
  }
  .method li:last-child > div {
    padding-bottom: 0;
  }
  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
    width: 9px;
    padding-top: 4px;
  }
  .rail i {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--text-muted);
  }
  .rail b {
    flex: 1 1 0;
    width: 1px;
    margin-top: 4px;
    background: var(--line-edge);
  }
  .method li:last-child .rail i {
    background: var(--accent-plumb);
  }
  .method li:last-child .rail b {
    display: none;
  }
  .step {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
  }
  .step span {
    color: var(--accent-plumb);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .copy {
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 20px;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .strip > div {
    min-width: 0;
    padding: 0 20px;
    border-left: 1px solid var(--rule);
  }
  .strip > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
  }
  .strip dd {
    margin-top: 4px;
    color: var(--text-primary);
    font-size: 18px;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: -0.18px;
  }
  .strip dd.note-cell {
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    letter-spacing: 0;
  }
  .own {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .run {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .run code {
    min-width: 0;
    color: var(--accent-plumb);
    font-size: 13px;
    line-height: 18px;
    font-variant-ligatures: none;
    overflow-wrap: anywhere;
  }
  .note {
    color: var(--text-muted);
    font-size: 13px;
    line-height: 20px;
  }
  .note code {
    color: var(--text-secondary);
    font-size: 12px;
    font-variant-ligatures: none;
  }

  @media (max-width: 1279px) {
    .body {
      flex-direction: column;
      gap: 40px;
    }
    .field {
      flex: none;
      width: 100%;
    }
    .method {
      width: 100%;
      max-width: 520px;
    }
  }
  @media (max-width: 1023px) {
    .commands thead th:nth-child(1) { width: 168px; }
    .commands thead th:nth-child(2) { width: 300px; }
    .issues thead th:nth-child(1) { width: 168px; }
    .ledger thead th:nth-child(1) { width: 196px; }
    .ledger thead th:nth-child(2) { width: 72px; }
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 0;
    }
    .strip > div,
    .strip > div:first-child {
      padding: 0 16px 0 0;
      border-left: 0;
    }
  }
  @media (max-width: 767px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    table,
    tbody,
    tr,
    tbody th,
    tbody td,
    tbody td.how,
    .commands tbody th,
    .commands tbody td,
    .issues tbody th,
    .issues tbody td,
    .issues tbody td.how,
    .issues tbody td.state {
      display: block;
      width: 100%;
      padding: 0;
    }
    tbody tr {
      padding: 12px 0;
    }
    .issues tbody td.how,
    .issues tbody td.state {
      margin-top: 4px;
    }
    .ledger tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 16px;
      align-items: start;
    }
    .ledger tbody th {
      width: auto;
    }
    .ledger tbody td.value {
      grid-column: 2;
      grid-row: 1;
      width: auto;
      text-align: right;
    }
    .ledger tbody td.how {
      grid-column: 1 / -1;
      width: auto;
      margin-top: 6px;
    }
    .run {
      justify-content: space-between;
      margin: 2px 0;
    }
  }
</style>
