---
/**
 * A soft mesh of light behind an opaque box. Blobs travel around the box's edge while each one
 * stretches, turns and shifts colour, so no two passes look the same.
 * Motion is in styles/motion.css. Without it, the blobs rest at their starting points.
 */
interface Props {
  variant: "hero" | "cta";
}
const { variant } = Astro.props;

const MINT = "110 231 200";
const BLUE = "143 162 255";
const VIOLET = "183 155 255";

/**
 * `at` is the start point on the orbit, from 0 to 1, clockwise from the top-left corner.
 * Lobe sizes and offsets are fractions of the mesh's unit. `a` is the lobe's peak strength.
 * The sway, turn, stretch and colour periods differ, so the shapes never visibly repeat.
 */
const blobs = [
  {
    at: 0.0,
    lobes: [
      { c: MINT, w: 1.3, h: 0.78, x: -0.14, y: 0.05, r: -16, a: 0.2, sway: 9, turn: 13, stretch: 7, colour: 8, flip: 0 },
      { c: BLUE, w: 0.86, h: 1.12, x: 0.2, y: -0.08, r: 28, a: 0.17, sway: 11, turn: 10, stretch: 9, colour: 8, flip: 1 },
    ],
  },
  {
    at: 0.13,
    lobes: [
      { c: VIOLET, w: 1.08, h: 0.7, x: 0.1, y: 0.12, r: 38, a: 0.16, sway: 12, turn: 9, stretch: 11, colour: 10, flip: 0 },
      { c: MINT, w: 0.72, h: 1.02, x: -0.16, y: -0.1, r: -30, a: 0.14, sway: 8, turn: 14, stretch: 8, colour: 10, flip: 1 },
    ],
  },
  {
    at: 0.52,
    lobes: [
      { c: BLUE, w: 1.36, h: 0.72, x: 0.12, y: -0.06, r: 12, a: 0.2, sway: 10, turn: 12, stretch: 10, colour: 9, flip: 0 },
      { c: VIOLET, w: 0.8, h: 1.16, x: -0.18, y: 0.1, r: -36, a: 0.16, sway: 13, turn: 8, stretch: 7, colour: 9, flip: 1 },
    ],
  },
  {
    at: 0.68,
    lobes: [
      { c: MINT, w: 0.98, h: 0.8, x: -0.08, y: 0.14, r: 52, a: 0.15, sway: 8, turn: 11, stretch: 12, colour: 11, flip: 0 },
      { c: BLUE, w: 0.7, h: 1.04, x: 0.16, y: -0.12, r: -20, a: 0.14, sway: 11, turn: 15, stretch: 9, colour: 11, flip: 1 },
    ],
  },
];

/** The same corner timings as the mesh-orbit keyframes. */
function restingPoint(at: number): [number, number] {
  if (at < 0.32) return [at / 0.32, 0];
  if (at < 0.5) return [1, (at - 0.32) / 0.18];
  if (at < 0.82) return [1 - (at - 0.5) / 0.32, 1];
  return [0, 1 - (at - 0.82) / 0.18];
}

type Lobe = (typeof blobs)[number]["lobes"][number];
const lobeStyle = (l: Lobe) =>
  [
    `--c:${l.c}`,
    `--a:${l.a}`,
    `--w:${l.w}`,
    `--h:${l.h}`,
    `--x:${l.x}`,
    `--y:${l.y}`,
    `--r:${l.r}deg`,
    `--sway:${l.sway}s`,
    `--turn:${l.turn}s`,
    `--stretch:${l.stretch}s`,
    `--colour:${l.colour}s`,
    `--flip:${l.flip}`,
  ].join(";");
---

<div class:list={["glow-mesh", variant]} aria-hidden="true">
  <div class="field">
    {blobs.map(({ at, lobes }) => {
      const [px, py] = restingPoint(at);
      return (
        <i class="blob" style={`--at:${at};--px:${px.toFixed(3)};--py:${py.toFixed(3)}`}>
          {lobes.map((lobe) => <b class="lobe" style={lobeStyle(lobe)}></b>)}
        </i>
      );
    })}
  </div>
</div>

<style>
  .glow-mesh {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    container-type: size;
    /* The orbit runs just inside the box, so most of each blob stays hidden behind it. */
    --inset: 40px;
    /* How far the light may show past the box before it has fully faded. */
    --bleed-t: 40px;
    --bleed-b: 56px;
    --bleed-l: min(56px, var(--gutter));
    --bleed-r: min(56px, var(--gutter));
  }
  .glow-mesh.cta {
    --inset: 28px;
    --bleed-t: 72px;
    --bleed-b: 92px;
    --bleed-l: 72px;
    --bleed-r: min(92px, var(--gutter));
  }
  /* A wider spread at lower strength, so the light fades out gradually. */
  .cta .field {
    opacity: 0.78;
  }
  /* The mask keeps the light in a tight halo around the box, with no hard edge. */
  .field {
    position: absolute;
    inset: calc(var(--bleed-t) * -1) calc(var(--bleed-r) * -1) calc(var(--bleed-b) * -1) calc(var(--bleed-l) * -1);
    mask-image:
      linear-gradient(
        to bottom,
        transparent 0,
        rgb(0 0 0 / 0.16) calc(var(--bleed-t) * 0.3),
        rgb(0 0 0 / 0.62) calc(var(--bleed-t) * 0.68),
        #000 var(--bleed-t),
        #000 calc(100% - var(--bleed-b)),
        rgb(0 0 0 / 0.62) calc(100% - var(--bleed-b) * 0.68),
        rgb(0 0 0 / 0.16) calc(100% - var(--bleed-b) * 0.3),
        transparent 100%
      ),
      linear-gradient(
        to right,
        transparent 0,
        rgb(0 0 0 / 0.16) calc(var(--bleed-l) * 0.3),
        rgb(0 0 0 / 0.62) calc(var(--bleed-l) * 0.68),
        #000 var(--bleed-l),
        #000 calc(100% - var(--bleed-r)),
        rgb(0 0 0 / 0.62) calc(100% - var(--bleed-r) * 0.68),
        rgb(0 0 0 / 0.16) calc(100% - var(--bleed-r) * 0.3),
        transparent 100%
      );
    mask-composite: intersect;
  }
  .blob {
    --unit: clamp(400px, 58cqw, 780px);
    position: absolute;
    top: var(--bleed-t);
    left: var(--bleed-l);
    display: block;
    width: 0;
    height: 0;
    transform: translate(
      calc(var(--inset) + var(--px) * (100cqw - var(--inset) * 2)),
      calc(var(--inset) + var(--py) * (100cqh - var(--inset) * 2))
    );
  }
  .cta .blob {
    --unit: clamp(400px, 122cqw, 600px);
  }
  .lobe {
    --tx: calc(var(--x) * var(--unit));
    --ty: calc(var(--y) * var(--unit));
    position: absolute;
    top: calc(var(--h) * var(--unit) / -2);
    left: calc(var(--w) * var(--unit) / -2);
    display: block;
    width: calc(var(--w) * var(--unit));
    height: calc(var(--h) * var(--unit));
    border-radius: 50%;
    translate: var(--tx) var(--ty);
    rotate: var(--r);
    /* A long eased falloff, so a lobe has no visible edge or bright core. */
    background: radial-gradient(
      closest-side,
      rgb(var(--c) / var(--a)) 0%,
      rgb(var(--c) / calc(var(--a) * 0.92)) 14%,
      rgb(var(--c) / calc(var(--a) * 0.74)) 28%,
      rgb(var(--c) / calc(var(--a) * 0.52)) 42%,
      rgb(var(--c) / calc(var(--a) * 0.32)) 56%,
      rgb(var(--c) / calc(var(--a) * 0.16)) 70%,
      rgb(var(--c) / calc(var(--a) * 0.06)) 84%,
      rgb(var(--c) / 0) 100%
    );
  }

  @media (max-width: 767px) {
    .glow-mesh,
    .glow-mesh.cta {
      --inset: 20px;
      --bleed-t: 28px;
      --bleed-b: 32px;
      --bleed-l: var(--gutter);
      --bleed-r: var(--gutter);
    }
    .glow-mesh.cta {
      --bleed-t: 40px;
      --bleed-b: 60px;
    }
  }
</style>
