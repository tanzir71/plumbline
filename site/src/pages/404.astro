---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import { url } from "../lib/url";
---

<Base title="Page not found — Plumbline" description="This page does not exist." canonicalPath="404/" noindex>
  <section class="nf" aria-labelledby="nf-title">
    <p class="code">404</p>
    <h1 id="nf-title">This page is out of plumb.</h1>
    <p class="lead">The page you asked for doesn't exist or has moved.</p>
    <div class="actions">
      <Button variant="primary" href={url()}>Back to home</Button>
      <Button href={url("docs/")}>Read the docs</Button>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    max-width: var(--content);
    min-height: 50vh;
    margin-inline: auto;
    padding: 88px var(--gutter);
    box-sizing: content-box;
  }
  .code {
    color: var(--accent-plumb);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.96px;
  }
  h1 {
    font-size: 32px;
    font-weight: 600;
    line-height: 38px;
    letter-spacing: -0.64px;
  }
  .lead {
    font-size: 15px;
    line-height: 24px;
    color: var(--text-secondary);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 12px;
  }
  @media (max-width: 767px) {
    .nf {
      padding-block: 64px;
    }
    h1 {
      font-size: 26px;
      line-height: 32px;
    }
  }
</style>
