{
  "name": "plumbline-monorepo",
  "version": "1.2.1",
  "private": true,
  "description": "Open-source code reviewer that checks the structure, not just the diff.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --if-present run test && node scripts/check-repo.mjs",
    "lint": "eslint . && pnpm -r --if-present run typecheck",
    "check:repo": "node scripts/check-repo.mjs",
    "check:pricing": "node scripts/check-pricing.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tanziro/plumbline": "workspace:*",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
